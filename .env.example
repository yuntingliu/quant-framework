# Copy this file to .env and fill in the RQ connection values locally.
# Never commit real values.
RQ_USER=
RQ_PASSWORD=
RQ_HOST=

# Optional password protection for a server deployment. Keep disabled for
# ordinary localhost development and never reuse the Linux SSH password.
ALPHALAB_WEB_AUTH_ENABLED=false
ALPHALAB_WEB_USERNAME=alphalab
ALPHALAB_WEB_PASSWORD=
