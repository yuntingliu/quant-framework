# Copy this file to .env and fill in the RQ connection values locally.
# Never commit real values.
RQ_USER=
RQ_PASSWORD=
RQ_HOST=

# Optional published Conexus Harness integration.
# CONEXUS_WEB_ORIGIN=https://adminer.cloud
CONEXUS_PUBLICATION_SLUG=alphalab-research-agent

# Local Agent: direct model connection; no Conexus cloud account is needed.
CONEXUS_MODEL_API_KEY=
CONEXUS_MODEL_ID=
CONEXUS_MODEL_BASE_URL=
# OpenAI-compatible endpoint, including a loopback model server.
# For a remote provider, for example: https://openrouter.ai/api/v1
# A loopback model endpoint does not require an API key.
# Optional direct web search. Research/data/backtest tools do not require it.
BRAVE_SEARCH_API_KEY=
