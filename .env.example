# Copy this file to .env and fill in the RQ connection values locally.
# Never commit real values.
RQ_USER=
RQ_PASSWORD=
RQ_HOST=

# Optional published Conexus Harness integration.
# CONEXUS_WEB_ORIGIN=https://alphalab.example.com
CONEXUS_PUBLICATION_SLUG=alphalab-research-agent

# Optional arbitrary-Python research Lab. It is disabled unless explicitly set.
# Recommended: build/pin a local image and use docker. Images are never pulled at run time.
ALPHALAB_PYTHON_LAB_RUNTIME=disabled
# ALPHALAB_PYTHON_LAB_IMAGE=alphalab-python-lab:local
# ALPHALAB_PYTHON_LAB_TIMEOUT_SECONDS=20
# ALPHALAB_PYTHON_LAB_MEMORY_MB=512
# ALPHALAB_PYTHON_LAB_CPUS=1
# ALPHALAB_PYTHON_LAB_PIDS_LIMIT=64
