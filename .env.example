# Copy this file to .env and fill in the RQ connection values locally.
# Never commit real values.
RQ_USER=
RQ_PASSWORD=
RQ_HOST=

# Optional published Conexus Harness integration.
# CONEXUS_WEB_ORIGIN=https://adminer.cloud
CONEXUS_PUBLICATION_SLUG=alphalab-research-agent

# Optional authentication for a hosted workstation. Credentials stay on the host.
ALPHALAB_WEB_AUTH_ENABLED=false
ALPHALAB_WEB_USERNAME=alphalab
ALPHALAB_WEB_PASSWORD=
