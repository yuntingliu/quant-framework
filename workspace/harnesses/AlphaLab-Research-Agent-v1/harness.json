{
  "summary": "面向 AlphaLab 工作台的可发布研究 Agent。通过稳定 FastAPI 契约读取数据、策略与回测，并在用户明确要求时运行回测或生成纸面信号。",
  "entryNodeId": "alphalab-research-agent-v1",
  "template": {
    "name": "AlphaLab Research Agent",
    "summary": "Published conversational research Agent for the AlphaLab workstation.",
    "description": "读取 AlphaLab 工作区上下文和浏览器本地对话历史，分析策略与风险，运行用户确认的回测/纸面信号，并产出可持久化的研究报告与结构化决策笔记。",
    "whenToUse": [
      "用户需要解释当前 AlphaLab 数据、策略、回测或纸面信号",
      "用户明确要求运行回测或生成纸面信号",
      "工作台需要保存在本机浏览器中的多轮量化研究会话"
    ],
    "whenNotToUse": [
      "启动、停止、构建或部署 AlphaLab 前后端",
      "修改源代码或执行任意 Shell 命令",
      "提交真实交易订单"
    ],
    "manifest": {
      "id": "alphalab.research-agent.v1",
      "name": "AlphaLab Research Agent",
      "summary": "Conversation-driven AlphaLab research workflow.",
      "description": "Uses AlphaLab FastAPI tools and emits a durable research document plus structured decision data.",
      "version": 1,
      "entrypoint": "alphalab-research-agent-v1",
      "inputs": [
        {
          "key": "request",
          "label": "Research request",
          "description": "The user's research question or requested AlphaLab action.",
          "type": "text",
          "required": true,
          "nodeId": "alphalab-research-agent-v1",
          "port": "task"
        },
        {
          "key": "context",
          "label": "Workspace context",
          "description": "Selected symbol, strategy, backtest, intent, and data status from the AlphaLab workstation.",
          "type": "json",
          "required": false,
          "defaultValue": {},
          "nodeId": "alphalab-research-context-v1",
          "port": "data"
        }
      ],
      "outputs": [
        {
          "key": "summary",
          "label": "Research answer",
          "description": "Final Agent response.",
          "type": "json",
          "nodeId": "alphalab-research-agent-v1",
          "port": "summary"
        },
        {
          "key": "decisionNotebook",
          "label": "Decision notebook",
          "description": "Structured classification, base case, risk case, next action, and candidates.",
          "type": "json",
          "nodeId": "alphalab-decision-notebook-v1",
          "port": "data"
        },
        {
          "key": "workspaceDocument",
          "label": "Research result document",
          "description": "Durable Markdown report with safe static HTML snippets.",
          "type": "note",
          "nodeId": "alphalab-research-document-v1",
          "port": "content"
        },
        {
          "key": "workspaceResult",
          "label": "Workspace result",
          "description": "Request-bound descriptor and optional interactive table attachment for the research document.",
          "type": "json",
          "nodeId": "alphalab-workspace-result-v1",
          "port": "data"
        },
        {
          "key": "workspaceCommands",
          "label": "Workspace commands",
          "description": "Validated navigation, selection, refresh, and layout commands consumed by the AlphaLab frontend.",
          "type": "json",
          "nodeId": "alphalab-workspace-commands-v1",
          "port": "data"
        }
      ],
      "permissions": [
        { "kind": "model", "required": true },
        { "kind": "network", "required": true }
      ],
      "dependencies": [
        { "kind": "model", "name": "openrouter" },
        { "kind": "runtime", "name": "conexus.runtime.v1" }
      ],
      "capabilities": ["quant-research", "backtest", "paper-signal", "decision-notebook", "workspace-control", "research-document", "research-table"],
      "triggers": ["research", "backtest", "strategy risk", "paper signal"],
      "tags": ["alphalab", "quant", "published-agent"]
    },
    "schemas": {
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request"],
        "properties": {
          "request": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "context": { "type": "object" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "decisionNotebook", "workspaceDocument", "workspaceResult", "workspaceCommands"],
        "properties": {
          "summary": { "type": "string" },
          "decisionNotebook": { "type": "object" },
          "workspaceDocument": { "type": "string" },
          "workspaceResult": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "requestId", "kind"],
            "properties": {
              "version": { "const": 1 },
              "requestId": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["none", "document"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "description": { "type": "string", "maxLength": 2000 },
              "columns": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "label"],
                  "properties": {
                    "key": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "format": { "enum": ["text", "number", "percent", "date", "datetime"] }
                  }
                }
              },
              "rows": { "type": "array", "maxItems": 1000, "items": { "type": "object" } },
              "sources": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
              "generatedAt": { "type": "string", "maxLength": 100 }
            }
          },
          "workspaceCommands": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "requestId", "commands"],
            "properties": {
              "version": { "const": 1 },
              "requestId": { "type": "string", "minLength": 1 },
              "commands": { "type": "array", "maxItems": 20, "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "runtime": {
      "policy": { "maxAttempts": 1, "allowParallel": false },
      "timeoutMs": 300000,
      "isolation": "none"
    },
    "verification": {
      "successCriteria": [
        "The final answer is grounded in AlphaLab API results or clearly marked as a hypothesis.",
        "Any backtest or signal action was explicitly requested by the user.",
        "The decisionNotebook output is updated before completion.",
        "A requested rich result is written to workspaceDocument and opened through a request-bound workspaceResult descriptor.",
        "Interactive table data is included in workspaceResult only when sorting, filtering, or CSV export is useful.",
        "The workspaceCommands output carries the current requestId and only declared frontend commands."
      ]
    }
  }
}
