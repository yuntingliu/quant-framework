{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "decisionNotebook",
    "workspaceResult",
    "workspaceCommands"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "decisionNotebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "baseCase",
        "riskCase",
        "nextAction",
        "candidateExpressions"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "baseCase": {
          "type": "string",
          "maxLength": 20000
        },
        "riskCase": {
          "type": "string",
          "maxLength": 20000
        },
        "nextAction": {
          "type": "string",
          "maxLength": 20000
        },
        "candidateExpressions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "workspaceResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "requestId",
            "kind"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "reportId",
            "requestId",
            "kind",
            "title",
            "sources"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "reportId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,199}$"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "const": "document"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sources": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "generatedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "label"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "text",
                      "number",
                      "percent",
                      "date",
                      "datetime"
                    ]
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "charts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "title",
                  "xKey",
                  "series",
                  "rows"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "line",
                      "bar",
                      "area",
                      "scatter",
                      "pie"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "xKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "xLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "yLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "series": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "label"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "format": {
                          "type": "string",
                          "enum": [
                            "number",
                            "percent"
                          ]
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}$"
                        }
                      }
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "maxProperties": 13,
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "dependentRequired": {
            "columns": [
              "rows"
            ],
            "rows": [
              "columns"
            ]
          }
        }
      ]
    },
    "workspaceCommands": {
      "type": "object",
      "description": "Frontend command batch. Always include version=1 and the current requestId. open_widget uses widgetId (never widget); set_focus must precede mode/widget commands when opening a project.",
      "additionalProperties": false,
      "required": [
        "version",
        "requestId",
        "commands"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "commands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "switch_mode",
                  "open_widget",
                  "open_result",
                  "close_widget",
                  "set_focus",
                  "set_link_symbol",
                  "show_right_rail",
                  "refresh_data",
                  "save_layout",
                  "reset_layout"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "project",
                  "data",
                  "factor",
                  "strategy",
                  "validation",
                  "report"
                ]
              },
              "widgetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Required for open_widget and close_widget. The field name is widgetId, never widget."
              },
              "resultId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "projectId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "backtestId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "group": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d"
                ]
              },
              "open": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "switch_mode"
                    }
                  }
                },
                "then": {
                  "required": [
                    "mode"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "open_widget",
                        "close_widget"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "widgetId"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "open_result"
                    }
                  }
                },
                "then": {
                  "required": [
                    "resultId"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "set_link_symbol"
                    }
                  }
                },
                "then": {
                  "required": [
                    "group",
                    "symbol"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  },
  "$comment": "AlphaLab application workspace payload contract; not a Conexus Harness output schema."
}
