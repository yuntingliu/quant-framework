{
  "summary": "面向 AlphaLab 工作台的可发布研究 Agent。通过完整 typed data tools 与稳定 FastAPI 契约组合数据、策略和回测，并生成报告、表格、图表与工作台操作。",
  "entryNodeId": "alphalab-research-agent-v1",
  "template": {
    "name": "AlphaLab Research Agent",
    "summary": "Published conversational research Agent for the AlphaLab workstation.",
    "description": "读取 AlphaLab 全部 typed data tools、市场/基本面/因子数据和工作区上下文，分析策略与风险，自主补齐所需 RQ runtime 数据，运行用户明确请求的回测或纸面信号，并产出可持久化的研究报告、表格、图表与结构化决策笔记。",
    "whenToUse": [
      "用户需要解释当前 AlphaLab 数据、策略、回测或纸面信号",
      "用户需要查询、校验或使用 AlphaLab runtime 数据，Agent 可自主补齐所需 RQ 分区",
      "用户需要生成可交互的研究表格或图表",
      "用户明确要求运行回测或生成纸面信号",
      "工作台需要保存在本机浏览器中的多轮量化研究会话"
    ],
    "whenNotToUse": [
      "启动、停止、构建或部署 AlphaLab 前后端",
      "修改源代码或执行任意 Shell 命令",
      "提交真实交易订单"
    ],
    "manifest": {
      "id": "alphalab.research-agent.v1",
      "name": "AlphaLab Research Agent",
      "summary": "Conversation-driven AlphaLab research workflow.",
      "description": "Uses the complete AlphaLab typed data-tool surface and research APIs, then emits durable documents, tables, charts, decision data, and validated workspace commands.",
      "version": 1,
      "defaultExposureId": "alphalab-research-agent",
      "permissions": [
        { "kind": "model", "required": true },
        { "kind": "network", "required": true }
      ],
      "dependencies": [
        { "kind": "model", "name": "openrouter" },
        { "kind": "runtime", "name": "conexus.runtime.v1" }
      ],
      "capabilities": ["quant-research", "data-operations", "market-data", "fundamentals", "factor-returns", "backtest", "paper-signal", "decision-notebook", "workspace-control", "research-document", "research-table", "research-chart"],
      "triggers": ["research", "data status", "data sync", "fundamentals", "factor returns", "backtest", "strategy risk", "paper signal", "report", "chart"],
      "tags": ["alphalab", "quant", "published-agent"],
      "exposures": [
        {
          "id": "alphalab-research-agent",
          "name": "AlphaLab Research Agent",
          "description": "Run the conversational AlphaLab research workflow.",
          "nodeId": "alphalab-research-agent-v1",
          "surfaces": ["agent_tool", "page", "api"],
          "inputs": [
        {
          "key": "request",
          "label": "Research request",
          "description": "The user's research question or requested AlphaLab action.",
          "type": "text",
          "required": true,
          "nodeId": "alphalab-research-agent-v1",
          "port": "task"
        },
        {
          "key": "context",
          "label": "Workspace context",
          "description": "Selected symbol, strategy, backtest, intent, and data status from the AlphaLab workstation.",
          "type": "json",
          "required": false,
          "defaultValue": {},
          "nodeId": "alphalab-research-context-v1",
          "port": "data"
        }
      ],
          "outputs": [
        {
          "key": "summary",
          "label": "Research answer",
          "description": "Final Agent response.",
          "type": "json",
          "nodeId": "alphalab-research-agent-v1",
          "port": "summary"
        },
        {
          "key": "decisionNotebook",
          "label": "Decision notebook",
          "description": "Structured classification, base case, risk case, next action, and candidates.",
          "type": "json",
          "nodeId": "alphalab-decision-notebook-v1",
          "port": "data"
        },
        {
          "key": "workspaceDocument",
          "label": "Research result document",
          "description": "Durable Markdown report with safe static HTML snippets.",
          "type": "note",
          "nodeId": "alphalab-research-document-v1",
          "port": "content"
        },
        {
          "key": "workspaceResult",
          "label": "Workspace result",
          "description": "Request-bound descriptor with optional interactive table and chart attachments for the research document.",
          "type": "json",
          "nodeId": "alphalab-workspace-result-v1",
          "port": "data"
        },
        {
          "key": "workspaceCommands",
          "label": "Workspace commands",
          "description": "Validated navigation, selection, refresh, and layout commands consumed by the AlphaLab frontend.",
          "type": "json",
          "nodeId": "alphalab-workspace-commands-v1",
          "port": "data"
        }
          ],
          "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request"],
        "properties": {
          "request": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "context": { "type": "object" }
        }
      },
          "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "decisionNotebook", "workspaceDocument", "workspaceResult", "workspaceCommands"],
        "properties": {
          "summary": { "type": "string" },
          "decisionNotebook": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "baseCase", "riskCase", "nextAction", "candidateExpressions"],
            "properties": {
              "classification": { "type": "string", "minLength": 1, "maxLength": 120 },
              "baseCase": { "type": "string", "maxLength": 20000 },
              "riskCase": { "type": "string", "maxLength": 20000 },
              "nextAction": { "type": "string", "maxLength": 20000 },
              "candidateExpressions": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string", "maxLength": 2000 }
              }
            }
          },
          "workspaceDocument": { "type": "string" },
          "workspaceResult": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "requestId", "kind"],
                "properties": {
                  "version": { "const": 1 },
                  "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "kind": { "const": "none" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "requestId", "kind", "title", "sources"],
                "properties": {
                  "version": { "const": 1 },
                  "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "kind": { "const": "document" },
                  "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "sources": {
                    "type": "array",
                    "maxItems": 20,
                    "items": { "type": "string", "minLength": 1, "maxLength": 500 }
                  },
                  "generatedAt": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["key", "label"],
                      "properties": {
                        "key": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                        "format": { "type": "string", "enum": ["text", "number", "percent", "date", "datetime"] }
                      }
                    }
                  },
                  "rows": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": ["string", "number", "boolean", "null"]
                      }
                    }
                  },
                  "charts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "type", "title", "xKey", "series", "rows"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "type": { "type": "string", "enum": ["line", "bar", "area", "scatter", "pie"] },
                        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
                        "xKey": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "xLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
                        "yLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
                        "series": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "label"],
                            "properties": {
                              "key": { "type": "string", "minLength": 1, "maxLength": 80 },
                              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                              "format": { "type": "string", "enum": ["number", "percent"] },
                              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
                            }
                          }
                        },
                        "rows": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 500,
                          "items": {
                            "type": "object",
                            "maxProperties": 13,
                            "additionalProperties": {
                              "type": ["string", "number", "boolean", "null"]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "dependentRequired": { "columns": ["rows"], "rows": ["columns"] }
              }
            ]
          },
          "workspaceCommands": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "requestId", "commands"],
            "properties": {
              "version": { "const": 1 },
              "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
              "commands": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["switch_mode", "open_widget", "open_result", "close_widget", "set_focus", "set_link_symbol", "show_right_rail", "refresh_data", "save_layout", "reset_layout"]
                    },
                    "mode": { "type": "string", "enum": ["home", "data", "research", "trading_a_share"] },
                    "widgetId": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "resultId": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "symbol": { "type": ["string", "null"], "maxLength": 200 },
                    "strategyId": { "type": ["string", "null"], "maxLength": 200 },
                    "backtestId": { "type": ["string", "null"], "maxLength": 200 },
                    "date": { "type": ["string", "null"], "maxLength": 200 },
                    "group": { "type": "string", "enum": ["a", "b", "c", "d"] },
                    "tab": { "type": "string", "enum": ["context", "agent", "activity"] },
                    "open": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
          }
        }
      ]
    },
    "runtime": {
      "policy": { "maxAttempts": 1, "allowParallel": false },
      "isolation": "none"
    },
    "verification": {
      "successCriteria": [
        "The final answer is grounded in AlphaLab API results or clearly marked as a hypothesis.",
        "Any backtest or signal action was explicitly requested by the user.",
        "The decisionNotebook output is updated before completion.",
        "A requested rich result is written to workspaceDocument and opened through a request-bound workspaceResult descriptor.",
        "Interactive table data is included in workspaceResult only when sorting, filtering, or CSV export is useful.",
        "Structured charts are included only when they materially improve interpretation and every plotted series is grounded in current tool results.",
        "RQ data synchronization runs autonomously when runtime data is missing, stale, or required by the current task; backtests and paper signals still require an explicit user request.",
        "The workspaceCommands output carries the current requestId and only declared frontend commands."
      ]
    }
  }
}
