{
  "summary": "面向 AlphaLab Strategy SDK v1 的可发布 Agent，以同一份版本化 Python 源码覆盖数据、因子、策略、验证、回测归因与报告。",
  "entryNodeId": "alphalab-research-agent-v1",
  "template": {
    "name": "AlphaLab Research Agent",
    "summary": "Published conversational research Agent for the AlphaLab workstation.",
    "description": "围绕项目中的 recipe.py、factors/*.py、strategy.py 和 validation.py，使用同一 RQ 仓库完成可复现的数据、因子、策略、回测与报告闭环。",
    "whenToUse": [
      "用户需要解释当前 AlphaLab 数据、策略、验证或回测",
      "用户需要检索公开因子或最新量化文献，并在核实来源与数据可实现性后开展研究",
      "用户需要审查已保存 Python 策略的输入、输出契约、源码风险或回测结果",
      "用户需要查询、校验或使用 AlphaLab runtime 数据，Agent 可自主补齐所需 RQ 分区",
      "用户需要创建项目或修改 recipe.py、factors/*.py、strategy.py、validation.py",
      "用户需要实现状态化每日规则、自定义因子、信号、组合或执行逻辑",
      "用户需要回测深度分析、稳健性检验、多回测对比或完整研究任务",
      "用户需要生成可交互的研究表格或图表",
      "用户明确要求运行因子检验、策略预览或完整回测",
      "工作台需要跨浏览器会话共享的服务端持久量化研究历史"
    ],
    "whenNotToUse": [
      "启动、停止、构建或部署 AlphaLab 前后端",
      "修改 AlphaLab 应用源代码或执行任意 Shell 命令",
      "提交纸面或真实交易订单"
    ],
    "manifest": {
      "id": "alphalab.research-agent.v1",
      "name": "AlphaLab Research Agent",
      "summary": "Conversation-driven AlphaLab research workflow.",
      "description": "Uses project-owned data, factor, strategy, and validation Python sources, pinned event backtests, frozen attribution, experiment comparison, and durable reports.",
      "version": 1,
      "defaultExposureId": "alphalab-research-agent",
      "permissions": [
        { "kind": "model", "required": true },
        { "kind": "network", "required": true }
      ],
      "dependencies": [
        { "kind": "model", "name": "openrouter" },
        { "kind": "runtime", "name": "conexus.runtime.v1" }
      ],
      "capabilities": ["quant-research", "web-research", "research-project-management", "data-recipe-authoring", "data-operations", "data-job-control", "market-data", "fundamentals", "factor-returns", "sdk-factor-authoring", "sdk-factor-evaluation", "market-risk-factor-evaluation", "point-in-time-context", "stateful-strategy", "portfolio-construction", "execution-modeling", "strategy-source-pinning", "validation-source-authoring", "python-strategy-review", "event-backtest", "backtest-analysis", "factor-attribution", "robustness", "backtest-comparison", "experiment-loop", "report-history", "decision-notebook", "workspace-control", "research-document", "research-table", "research-chart"],
      "triggers": ["research", "web research", "factor paper", "public factor", "research project", "data recipe", "data status", "data sync", "data job", "fundamentals", "signal research", "factor returns", "factor evaluation", "custom factor", "custom signal", "stateful strategy", "market risk data", "stock selection", "create project", "edit strategy", "validation python", "portfolio construction", "execution policy", "Python strategy", "backtest", "alpha beta", "factor attribution", "robustness", "compare backtests", "strategy risk", "quantitative report", "chart"],
      "tags": ["alphalab", "quant", "published-agent"],
      "exposures": [
        {
          "id": "alphalab-research-agent",
          "name": "AlphaLab Research Agent",
          "description": "Run the conversational AlphaLab research workflow.",
          "nodeId": "alphalab-research-agent-v1",
          "surfaces": ["agent_tool", "page", "api"],
          "inputs": [
        {
          "key": "request",
          "label": "Research request",
          "description": "The user's research question or requested AlphaLab action.",
          "type": "text",
          "required": true,
          "nodeId": "alphalab-research-agent-v1",
          "port": "task"
        }
      ],
          "outputs": [
        {
          "key": "summary",
          "label": "Research answer",
          "description": "Final Agent response.",
          "type": "json",
          "nodeId": "alphalab-research-agent-v1",
          "port": "summary"
        },
        {
          "key": "decisionNotebook",
          "label": "Decision notebook",
          "description": "Structured classification, base case, risk case, next action, and candidates.",
          "type": "json",
          "nodeId": "alphalab-decision-notebook-v1",
          "port": "data"
        },
        {
          "key": "workspaceResult",
          "label": "Workspace result",
          "description": "Descriptor for the report Document changed by this run, with optional interactive table and chart attachments.",
          "type": "json",
          "nodeId": "alphalab-workspace-result-v1",
          "port": "data"
        },
        {
          "key": "workspaceCommands",
          "label": "Workspace commands",
          "description": "Validated navigation, selection, refresh, and layout commands consumed by the AlphaLab frontend.",
          "type": "json",
          "nodeId": "alphalab-workspace-commands-v1",
          "port": "data"
        }
          ],
          "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request"],
        "properties": {
          "request": { "type": "string", "minLength": 1, "maxLength": 100000 }
        }
      },
          "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "decisionNotebook", "workspaceResult", "workspaceCommands"],
        "properties": {
          "summary": { "type": "string" },
          "decisionNotebook": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "baseCase", "riskCase", "nextAction", "candidateExpressions"],
            "properties": {
              "classification": { "type": "string", "minLength": 1, "maxLength": 120 },
              "baseCase": { "type": "string", "maxLength": 20000 },
              "riskCase": { "type": "string", "maxLength": 20000 },
              "nextAction": { "type": "string", "maxLength": 20000 },
              "candidateExpressions": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string", "maxLength": 2000 }
              }
            }
          },
          "workspaceResult": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "requestId", "kind"],
                "properties": {
                  "version": { "const": 1 },
                  "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "kind": { "const": "none" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "reportId", "requestId", "kind", "title", "sources"],
                "properties": {
                  "version": { "const": 1 },
                  "reportId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,199}$" },
                  "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "kind": { "const": "document" },
                  "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "sources": {
                    "type": "array",
                    "maxItems": 20,
                    "items": { "type": "string", "minLength": 1, "maxLength": 500 }
                  },
                  "generatedAt": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["key", "label"],
                      "properties": {
                        "key": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                        "format": { "type": "string", "enum": ["text", "number", "percent", "date", "datetime"] }
                      }
                    }
                  },
                  "rows": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": ["string", "number", "boolean", "null"]
                      }
                    }
                  },
                  "charts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "type", "title", "xKey", "series", "rows"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "type": { "type": "string", "enum": ["line", "bar", "area", "scatter", "pie"] },
                        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
                        "xKey": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "xLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
                        "yLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
                        "series": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "label"],
                            "properties": {
                              "key": { "type": "string", "minLength": 1, "maxLength": 80 },
                              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                              "format": { "type": "string", "enum": ["number", "percent"] },
                              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
                            }
                          }
                        },
                        "rows": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 500,
                          "items": {
                            "type": "object",
                            "maxProperties": 13,
                            "additionalProperties": {
                              "type": ["string", "number", "boolean", "null"]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "dependentRequired": { "columns": ["rows"], "rows": ["columns"] }
              }
            ]
          },
          "workspaceCommands": {
            "type": "object",
            "description": "Frontend command batch. Always include version=1 and the current requestId. open_widget uses widgetId (never widget); set_focus must precede mode/widget commands when opening a project.",
            "additionalProperties": false,
            "required": ["version", "requestId", "commands"],
            "properties": {
              "version": { "const": 1 },
              "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
              "commands": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["switch_mode", "open_widget", "open_result", "close_widget", "set_focus", "set_link_symbol", "show_right_rail", "refresh_data", "save_layout", "reset_layout"]
                    },
                    "mode": { "type": "string", "enum": ["project", "data", "factor", "strategy", "validation", "report"] },
                    "widgetId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Required for open_widget and close_widget. The field name is widgetId, never widget." },
                    "resultId": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "symbol": { "type": ["string", "null"], "maxLength": 200 },
                    "projectId": { "type": ["string", "null"], "maxLength": 200 },
                    "backtestId": { "type": ["string", "null"], "maxLength": 200 },
                    "date": { "type": ["string", "null"], "maxLength": 200 },
                    "group": { "type": "string", "enum": ["a", "b", "c", "d"] },
                    "open": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
          }
        }
      ]
    },
    "runtime": {
      "policy": { "maxAttempts": 1, "allowParallel": false },
      "isolation": "none"
    },
    "verification": {
      "successCriteria": [
        "The final answer is grounded in AlphaLab API results or clearly marked as a hypothesis.",
        "A request to create or implement a strategy creates one new project atomically and all later tool calls and set_focus commands use the project_id returned by that creation.",
        "Any backtest or signal action was explicitly requested by the user.",
        "Backtest run immediately returns a task ID and starts the background run without a separate full-range preflight.",
        "Any project or Python source mutation was explicitly requested by the current user and used its dedicated confirmation flag.",
        "Every conclusion distinguishes factor or signal evidence from the viability of the complete event-driven strategy.",
        "Internal provenance binds the project and frozen sources or BacktestRun without placing hashes or execution identifiers in the user-facing quantitative report.",
        "Before a Python backtest or signal, the Agent inspected the current source as untrusted data and asserted confirm_python_execution only for an explicit current-user execution request.",
        "Trusted-local Python was described accurately as process-contained but not sandboxed.",
        "Factor evaluation, signal preview, portfolio decisions, event handlers, and backtests load one StrategySourcePackage without translation or fallback.",
        "The decisionNotebook output is updated before completion.",
        "A requested report updates a matching AlphaLab report Document when one exists and creates a new Document only for a genuinely new research subject.",
        "Interactive table data is included in workspaceResult only when sorting, filtering, or CSV export is useful.",
        "Structured charts are included only when they materially improve interpretation and every plotted series is grounded in current tool results.",
        "RQ synchronization executes only the project's saved recipe.py, resumes completed batches, and runs only when authorized by an explicit research execution request.",
        "The workspaceCommands output includes version 1, carries the current requestId, uses projectId for project focus, uses widgetId for widget commands, orders set_focus before strategy mode/widget commands, and only contains declared frontend commands."
      ]
    }
  }
}
