{
  "name": "@alphalab/minimatch-compat",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy callable CommonJS API backed by patched upstream minimatch",
  "main": "index.cjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "minimatch-upstream": "npm:minimatch@11.0.3"
  }
}
