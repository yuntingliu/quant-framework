{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:alphalab:collaboration:run-record:v1",
  "title": "Collaboration development measurement record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "task_id",
    "fixture",
    "paired_case_id",
    "arm",
    "mode",
    "repetition",
    "seed",
    "source",
    "environment",
    "configuration",
    "budget",
    "root_run_id",
    "child_run_ids",
    "started_at",
    "finished_at",
    "timings",
    "roles",
    "totals",
    "attempts",
    "human_interventions",
    "outcome",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/definitions/hash"
        },
        "manifest_sha256": {
          "$ref": "#/definitions/nullable_hash"
        }
      }
    },
    "paired_case_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "single",
        "single_self_check",
        "two_agent"
      ]
    },
    "mode": {
      "enum": [
        "scripted",
        "live"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "working_commit",
        "core_revision",
        "dirty",
        "diff_sha256",
        "dependency_hashes"
      ],
      "properties": {
        "base_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "working_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "core_revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "diff_sha256": {
          "$ref": "#/definitions/hash"
        },
        "dependency_hashes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/hash"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "node",
        "platform"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "provider",
        "prompt_version",
        "schema_version",
        "policy_version",
        "evidence_manifest",
        "usage_note"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "model_calls",
        "tokens",
        "cost",
        "currency",
        "enforcement"
      ],
      "properties": {
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "enforcement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "child_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_seconds",
        "request_to_terminal_seconds",
        "total_seconds",
        "queue_seconds",
        "start_kind"
      ],
      "properties": {
        "startup_seconds": {
          "type": "number",
          "minimum": 0
        },
        "request_to_terminal_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "queue_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "start_kind": {
          "enum": [
            "cold",
            "warm",
            "unknown"
          ]
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "model_calls",
          "tool_calls",
          "retries",
          "searches",
          "usage",
          "cost"
        ],
        "properties": {
          "role": {
            "enum": [
              "researcher",
              "reviewer"
            ]
          },
          "model_calls": {
            "type": "integer",
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0
          },
          "retries": {
            "type": "integer",
            "minimum": 0
          },
          "searches": {
            "type": "integer",
            "minimum": 0
          },
          "usage": {
            "$ref": "#/definitions/usage"
          },
          "cost": {
            "$ref": "#/definitions/cost"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "tool_calls",
        "retries",
        "searches",
        "usage",
        "cost"
      ],
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "searches": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/definitions/usage"
        },
        "cost": {
          "$ref": "#/definitions/cost"
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "round",
          "status",
          "http_status",
          "tool_names"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "researcher",
              "reviewer"
            ]
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "timeout"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "tool_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "human_interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "at",
          "reason",
          "active_seconds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "clarification",
              "approval",
              "manual_repair",
              "manual_rerun",
              "other"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "active_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "qualified",
        "quality_scores"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "cancelled",
            "timeout",
            "invalid_configuration",
            "skipped"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "quality_scores": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_hash": {
      "anyOf": [
        {
          "$ref": "#/definitions/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_tokens",
        "output_tokens",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "actual",
            "estimated",
            "unavailable"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "amount",
        "currency",
        "pricing_snapshot",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "actual",
            "estimated",
            "unavailable",
            "scripted_no_external_provider"
          ]
        },
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
